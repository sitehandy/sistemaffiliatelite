                    type="url"
                    label="MOD_AFFILIATE_TRACKER_API_URL_LABEL"
                    description="MOD_AFFILIATE_TRACKER_API_URL_DESC"
                    default=""
                />
                <field
                    name="api_key"
                    type="text"
                    label="MOD_AFFILIATE_TRACKER_API_KEY_LABEL"
                    description="MOD_AFFILIATE_TRACKER_API_KEY_DESC"
                    default=""
                />
                <field
                    name="cookie_duration"
                    type="number"
                    label="MOD_AFFILIATE_TRACKER_COOKIE_DURATION_LABEL"
                    description="MOD_AFFILIATE_TRACKER_COOKIE_DURATION_DESC"
                    default="30"
                    min="1"
                    max="365"
