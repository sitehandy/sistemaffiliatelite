    <copyright>Copyright (C) Your Company. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>support@your-domain.com</authorEmail>
    <authorUrl>https://your-domain.com</authorUrl>
    <version>1.0.0</version>
    <description>MOD_AFFILIATE_TRACKER_DESC</description>

    <files>
        <filename module="mod_affiliate_tracker">mod_affiliate_tracker.php</filename>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/mod_affiliate_tracker.ini</language>
        <language tag="en-GB">language/en-GB/mod_affiliate_tracker.sys.ini</language>
